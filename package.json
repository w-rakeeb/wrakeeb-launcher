{
  "name": "wrakeeb-launcher",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "desktop": "tauri dev",
    "package": "tauri build --no-bundle",
    "test": "vitest run tests/catalog.test.ts",
    "test:ui": "playwright test",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:native-ui": "node tests/native-smoke.mjs",
    "package:installer": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^4.0.0"
  }
}
