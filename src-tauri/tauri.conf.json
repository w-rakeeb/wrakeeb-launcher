{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wrakeeb Launcher",
  "version": "0.5.0",
  "identifier": "com.wrakeeb.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Wrakeeb",
    "shortDescription": "Applications, scripts and utilities in one Windows library.",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Wrakeeb",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "resources": {
      "../docs/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../PRIVACY.md": "PRIVACY.md",
      "../SECURITY.md": "SECURITY.md",
      "../docs/RIGHTS-REVIEW.md": "RIGHTS-REVIEW.md"
    }
  }
}
